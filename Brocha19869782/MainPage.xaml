<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Brocha19869782.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Label Text="Calculadora de Presupuesto"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

            <!-- Entrada de Metros Cuadrados -->
            <Label Text="Metros cuadrados a pintar:" />
            <Entry x:Name="MetrosEntry"
               Placeholder="Ej. 50"
               Keyboard="Numeric" />

            <!-- Entrada de Precio por Metro Cuadrado -->
            <Label Text="Precio cobrado por metro:" />
            <Entry x:Name="PrecioEntry"
               Placeholder="Ej. 12.50"
               Keyboard="Numeric" />

            <!-- Botón para calcular -->
            <Button Text="Calcular Presupuesto"
                Clicked="Button_Clicked"
                BackgroundColor="#512BD4"
                TextColor="White" />

            <!-- Resultado -->
            <Label x:Name="ResultadoLabel"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Green" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
